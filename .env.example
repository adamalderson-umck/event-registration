# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# PayPal (optional — only needed if payment is enabled)
# VITE_PAYPAL_CLIENT_ID=your-paypal-client-id

# Default org (optional — makes the root domain load this org's event landing page)
# Set to your org's slug (e.g. "umckent") to avoid the generic no-org screen
# VITE_DEFAULT_ORG=your-org-slug
