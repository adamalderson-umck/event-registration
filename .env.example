# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Default org (optional — makes the root domain load this org's event landing page)
# Set to your org's slug (e.g. "umckent") to avoid the generic no-org screen
# VITE_DEFAULT_ORG=your-org-slug

# Sentry (optional — error monitoring)
# Get your DSN at https://sentry.io → Project Settings → Client Keys
# VITE_SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz

# Cloudflare Turnstile CAPTCHA (optional — bot protection on public registration form)
# Get your site key at https://dash.cloudflare.com → Turnstile
# VITE_TURNSTILE_SITE_KEY=your-site-key
